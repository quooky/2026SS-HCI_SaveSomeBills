# Copy this file to .env and fill in your local values.
# ⚠️  NEVER commit .env — it's in .gitignore for a reason!

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME=MyApp

# ── Database (if applicable) ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Auth / Sessions ────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string
JWT_SECRET=change_this_too

# ── External APIs (add/remove as needed) ───────────────────
# API_BASE_URL=https://api.example.com
# API_KEY=your_api_key_here
# FIREBASE_API_KEY=
# MAPS_API_KEY=
