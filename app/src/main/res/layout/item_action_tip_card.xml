<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/spacing_xs"
    app:cardBackgroundColor="?attr/appColorSurface"
    app:cardCornerRadius="@dimen/corner_lg"
    app:cardElevation="@dimen/elevation_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <!-- Emoji + title + info icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/tv_action_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="⚡"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tv_action_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/appColorOnSurface" />

            <ImageButton
                android:id="@+id/btn_action_info"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_info_details"
                android:contentDescription="Mehr Infos"
                android:tint="?attr/appColorAccent" />

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_dismiss"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/btn_dismiss_action"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/appColorOnSurface"
                app:backgroundTint="?attr/appColorSurface"
                app:cornerRadius="@dimen/corner_lg"
                app:strokeColor="?attr/appColorOutline"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_action_confirm"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/spacing_xs"
                android:layout_weight="1"
                android:text="@string/btn_confirm_action"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/appColorOnSurface"
                app:backgroundTint="?attr/appColorAccent"
                app:cornerRadius="@dimen/corner_lg" />

        </LinearLayout>

        <!-- Hidden stubs for adapter compatibility -->
        <TextView
            android:id="@+id/tv_action_saving"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tv_action_desc"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>