<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/spacing_md"
    android:layout_marginEnd="@dimen/spacing_md"
    android:layout_marginBottom="@dimen/spacing_sm"
    app:cardBackgroundColor="?attr/appColorSurface"
    app:cardCornerRadius="@dimen/corner_md"
    app:cardElevation="@dimen/elevation_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_sm"
        android:gravity="center_vertical">

        <!-- Icon -->
        <TextView
            android:id="@+id/device_list_icon"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:gravity="center"
            android:text="⚡"
            android:textSize="28sp" />

        <!-- Name + badges -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/spacing_md">

            <TextView
                android:id="@+id/device_list_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="name"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/appColorOnSurface"
                android:layout_marginBottom="6dp" />

            <!-- Badge row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Verbrauch badge (green) -->
                <TextView
                    android:id="@+id/device_list_energy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 W"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/green_20"
                    android:background="@drawable/badge_chip"
                    android:backgroundTint="@color/green_90"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Betrieb badge (teal) -->
                <TextView
                    android:id="@+id/device_list_usage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 h/Tag"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/teal_40"
                    android:background="@drawable/badge_chip"
                    android:backgroundTint="@color/teal_90"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginEnd="6dp" />

                <!-- Kosten badge (amber) -->
                <TextView
                    android:id="@+id/device_list_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00 €/Tag"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/amber_40"
                    android:background="@drawable/badge_chip"
                    android:backgroundTint="@color/amber_90"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Edit button -->
        <ImageButton
            android:id="@+id/device_list_edit"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_edit"
            app:tint="?attr/appColorOnSurfaceVariant" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
