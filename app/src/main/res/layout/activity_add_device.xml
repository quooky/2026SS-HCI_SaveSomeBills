<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackground"
    tools:context=".AddDevice">

    <!-- Top bar -->
    <ImageButton
        android:id="@+id/imageButton3"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginStart="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        app:tint="?attr/appColorOnSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imageButton2"
        android:layout_width="@dimen/icon_button_size"
        android:layout_height="@dimen/icon_button_size"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:layout_marginTop="@dimen/spacing_sm"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_dialog_info"
        app:tint="?attr/appColorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginTop="@dimen/spacing_sm"
        android:text="Neues Gerät"
        android:textAppearance="?attr/textAppearanceHeadlineLarge"
        android:textColor="?attr/appColorOnSurface"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageButton3" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md"
        app:layout_constraintBottom_toTopOf="@id/bottom_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title">

        <!-- Icon picker row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Icon"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/appColorOnSurface" />

            <TextView
                android:id="@+id/tv_device_icon"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:background="?attr/appColorSurface"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="⚡"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- Name + Room in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="Name"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/appColorOnSurface" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="?attr/appColorSurface"
                    app:boxStrokeColor="@color/input_stroke"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/input_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="z.B. Laptop"
                        android:inputType="text"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:textColor="?attr/appColorOnSurface"
                        android:textColorHint="?attr/appColorOnSurfaceVariant" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="Raum"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/appColorOnSurface" />

                <Spinner
                    android:id="@+id/spinner_room"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:background="?attr/appColorSurface"
                    android:paddingStart="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_xl"
                    android:popupBackground="?attr/appColorSurface"
                    android:textColor="?attr/appColorOnSurface" />
            </LinearLayout>

        </LinearLayout>

        <!-- In Betrieb -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="In Betrieb (Stunden/Tag)"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/appColorOnSurface" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxBackgroundColor="?attr/appColorSurface"
            app:boxStrokeColor="@color/input_stroke"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_on_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 - 24"
                android:inputType="number"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/appColorOnSurface"
                android:textColorHint="?attr/appColorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Standby -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="Standby (Stunden/Tag)"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/appColorOnSurface" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            app:boxBackgroundColor="?attr/appColorSurface"
            app:boxStrokeColor="@color/input_stroke"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_standby_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="0 - 24"
                android:inputType="number"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/appColorOnSurface"
                android:textColorHint="?attr/appColorOnSurfaceVariant" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Manuelle Watt Angabe (collapsible) -->
        <LinearLayout
            android:id="@+id/header_watt_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manuelle Watt Angabe"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/appColorOnSurface" />

            <TextView
                android:id="@+id/tv_watt_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textColor="?attr/appColorOnSurfaceVariant"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_watt_manual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:layout_weight="1"
                app:boxBackgroundColor="?attr/appColorSurface"
                app:boxStrokeColor="@color/input_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_watt_on"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="W aktiv"
                    android:inputType="number"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/appColorOnSurface"
                    android:textColorHint="?attr/appColorOnSurfaceVariant" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_weight="1"
                app:boxBackgroundColor="?attr/appColorSurface"
                app:boxStrokeColor="@color/input_stroke"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_watt_standby"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="W Standby"
                    android:inputType="number"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/appColorOnSurface"
                    android:textColorHint="?attr/appColorOnSurfaceVariant" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- EasyScan button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_easy_scan"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:text="EasyScan"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/appColorOnSurface"
            app:backgroundTint="?attr/appColorAccent"
            app:cornerRadius="@dimen/corner_lg"
            app:icon="@drawable/ic_camera"
            app:iconGravity="textStart" />

        <!-- Vorhersage card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/appColorCardBackground"
            app:cardCornerRadius="@dimen/corner_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_md">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:text="Vorhersage"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/appColorAccent"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kosten pro Stunde"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/appColorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tv_cost_per_hour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.00 €/h"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/appColorWarning"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/gradient_bar_container"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/gradient_bar_height"
                    android:clipChildren="false">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/gradient_cost_bar" />

                    <View
                        android:id="@+id/gradient_bar_indicator"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical|start"
                        android:background="@drawable/indicator_circle"
                        android:elevation="@dimen/elevation_sm"
                        android:visibility="invisible" />

                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_md"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="Abbrechen"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/appColorOnSurface"
            app:backgroundTint="?attr/appColorSurface"
            app:cornerRadius="@dimen/corner_lg" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="Bestätigen"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/appColorOnSurface"
            app:backgroundTint="?attr/appColorAccent"
            app:cornerRadius="@dimen/corner_lg" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
