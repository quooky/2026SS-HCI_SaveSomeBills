<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <TextView
        android:id="@+id/device_group_icon"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="44dp"
        android:text="🏡"
        android:textAlignment="center"
        android:textSize="34sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/device_group_energy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="7dp"
        android:text="0"
        app:layout_constraintStart_toEndOf="@+id/device_group_icon"
        app:layout_constraintTop_toBottomOf="@+id/device_group_name" />

    <TextView
        android:id="@+id/device_group_unit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="7dp"
        android:text="⌀ e/m"
        app:layout_constraintStart_toEndOf="@+id/device_group_energy"
        app:layout_constraintTop_toBottomOf="@+id/device_group_name" />

    <TextView
        android:id="@+id/device_group_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="48dp"
        android:text="name"
        app:layout_constraintStart_toEndOf="@+id/device_group_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/device_group_button"
        android:layout_width="406dp"
        android:layout_height="135dp"
        android:background="#27FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>