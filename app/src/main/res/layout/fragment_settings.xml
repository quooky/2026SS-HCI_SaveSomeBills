<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackground"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceHeadlineLarge"
            android:textColor="?attr/appColorOnSurface"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Sparziel card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        app:cardBackgroundColor="?attr/appColorSurface"
        app:cardCornerRadius="@dimen/corner_md"
        app:cardElevation="@dimen/elevation_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_goal_label"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/appColorAccent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Wie viel möchtest du monatlich sparen?"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/appColorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundColor="?attr/appColorSurface"
                app:boxStrokeColor="@color/input_stroke"
                app:hintEnabled="false"
                app:suffixText="@string/settings_goal_suffix"
                app:suffixTextColor="?attr/appColorOnSurfaceVariant">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_savings_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="50"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/appColorOnSurface"
                    android:textColorHint="?attr/appColorOnSurfaceVariant" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Einheit card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        app:cardBackgroundColor="?attr/appColorSurface"
        app:cardCornerRadius="@dimen/corner_md"
        app:cardElevation="@dimen/elevation_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_unit_label"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/appColorAccent"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="Zeige Energieverbrauch in:"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/appColorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_unit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unit_kwh"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="kWh"
                    android:textColor="?attr/appColorOnSurface"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unit_phone"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/appColorOnSurface"
                    android:text="📱 Handy"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unit_ev"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?attr/appColorOnSurface"
                    android:text="⚡ E-Auto"
                    android:textSize="12sp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tv_unit_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/appColorOnSurfaceVariant" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Save button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_save_settings"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/spacing_lg"
        android:text="@string/settings_save"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/appColorOnSurface"
        app:backgroundTint="?attr/appColorAccent"
        app:cornerRadius="@dimen/corner_lg" />

</LinearLayout>
