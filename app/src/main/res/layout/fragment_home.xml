<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appColorBackground"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <TextView
        android:id="@+id/greeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_sm"
        android:text="@string/greeting"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="?attr/appColorOnSurface" />

    <!-- Sparziel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/histogram_widget"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardBackgroundColor="?attr/appColorSurface"
        app:cardCornerRadius="@dimen/corner_md"
        app:cardElevation="@dimen/elevation_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/hist_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/savings_target"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/appColorOnSurface" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/spacing_sm">

                <LinearLayout
                    android:id="@+id/histogram_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom"
                    android:orientation="horizontal" />

                <View
                    android:id="@+id/threshold_line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="75dp"
                    android:background="@drawable/dotted_line"
                    android:layerType="software" />

                <TextView
                    android:id="@+id/threshold_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="77dp"
                    android:text="@string/threshold_value"
                    android:textColor="?attr/appColorOnSurfaceVariant"
                    android:textSize="@dimen/text_xs" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/march" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_sm" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/april" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_sm" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="@string/may" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_sm" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Happy Hours -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/electricity_widget"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/spacing_sm"
        app:cardBackgroundColor="?attr/appColorSurface"
        app:cardCornerRadius="@dimen/corner_md"
        app:cardElevation="@dimen/elevation_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <TextView
                android:id="@+id/elec_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/electricity_prices_today"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/appColorOnSurface" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_weight="1"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="match_parent"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:gravity="bottom"
                        android:paddingStart="0dp"
                        android:paddingEnd="@dimen/spacing_xs"
                        android:text="@string/elec_unit"
                        android:textColor="?attr/appColorOnSurfaceVariant"
                        android:textSize="8sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical"
                        android:paddingEnd="@dimen/spacing_xs"
                        android:paddingStart="0dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:text="@string/max_elec_value" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:text="@string/high_elec_value" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:text="@string/mid_elec_value" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                        <TextView android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:text="@string/low_elec_value" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="bottom" android:text="@string/min_value" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:id="@+id/electricity_graph_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="bottom"
                        android:orientation="horizontal" />

                    <View
                        android:id="@+id/current_time_line"
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:background="@color/amber_40"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal"
                android:paddingEnd="0dp"
                android:paddingStart="32dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="1" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="4" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="7" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="10" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="13" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="16" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="19" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="22" android:textColor="?attr/appColorOnSurfaceVariant" android:textSize="@dimen/text_xs" />
            </LinearLayout>

            <TextView
                android:id="@+id/cheapest_hours_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/cheapest_hours_label"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/appColorAccent" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Geräteverbrauch -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/pie_chart_widget"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="?attr/appColorSurface"
        app:cardCornerRadius="@dimen/corner_md"
        app:cardElevation="@dimen/elevation_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pie_chart_pager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/dots_pie_chart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="@dimen/spacing_sm" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
