<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outlined box background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_lg" />
            <stroke
                android:width="1dp"
                android:color="@color/neutral_60" />
            <solid android:color="@color/neutral_20" />
        </shape>
    </item>

    <!-- Dropdown chevron arrow on the right -->
    <item
        android:gravity="end|center_vertical"
        android:right="12dp">
        <rotate
            android:fromDegrees="45"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="rectangle">
                <size
                    android:width="10dp"
                    android:height="10dp" />
                <stroke
                    android:width="2dp"
                    android:color="@color/neutral_60" />
                <solid android:color="@android:color/transparent" />
            </shape>
        </rotate>
    </item>

</layer-list>
